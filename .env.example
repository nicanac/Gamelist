# Copy to .env.local (never commit real secrets).

# Brain API token (https://brain.nicode.eu/settings/tokens, needs records:read + records:write).
# Without it the app serves the committed snapshot in src/data/library.json.
BRAIN_TOKEN=

# Optional: override the Brain API or web URLs (defaults shown).
# BRAIN_API_URL=https://api-brain.nicode.eu
# BRAIN_WEB_URL=https://brain.nicode.eu
# BRAIN_GAMES_CATALOG=games

# Optional: sharper cover art from IGDB (a free Twitch developer app: https://dev.twitch.tv/console/apps).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: lets a deployed site save status, rating and feedback back to Brain.
# - `npm run dev` saves without a password.
# - Deployed behind Pocket ID / TinyAuth forward-auth (`nicode-sso`), set TRUST_PROXY_AUTH=true.
# - Or set EDIT_PASSWORD to require a password on the form.
TRUST_PROXY_AUTH=
EDIT_PASSWORD=

# Optional: on-demand refresh. POST /api/revalidate with "Authorization: Bearer <REVALIDATE_SECRET>".
REVALIDATE_SECRET=

# Optional: public URL for social preview images when not hosted on Vercel.
SITE_URL=
# Optional: contact string sent to Wikipedia with cover lookups.
COVER_USER_AGENT=
