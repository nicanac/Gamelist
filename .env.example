# Copy to .env.local (never commit real secrets).

# Notion integration token: https://www.notion.so/profile/integrations
# Without it the app serves the committed snapshot in src/data/library.json.
NOTION_TOKEN=

# The "Game List" data source in your workspace (preferred), or its parent database.
NOTION_DATA_SOURCE_ID=47324caa-9784-4e44-8dc3-9e76f414799f
# NOTION_DATABASE_ID=11955c5f-eb25-4007-892c-469a777f931f

# Optional: sharper cover art from IGDB (a free Twitch developer app: https://dev.twitch.tv/console/apps).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: lets a deployed site save status, rating and feedback to Notion (the token needs edit access).
# `npm run dev` saves without it; deployed without it, the game view is read-only.
EDIT_PASSWORD=

# Optional: on-demand refresh. POST /api/revalidate with "Authorization: Bearer <REVALIDATE_SECRET>".
REVALIDATE_SECRET=
# Optional: verification token of a Notion integration webhook pointing at /api/revalidate.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Optional: public URL for social preview images when not hosted on Vercel.
SITE_URL=
# Optional: contact string sent to Wikipedia with cover lookups.
COVER_USER_AGENT=
